VITE_ENTRA_CLIENT_ID=<UI-SPA-APPLICATION-ID>
VITE_ENTRA_TENANT_ID=<DIRECTORY-TENANT-ID>
VITE_ENTRA_REDIRECT_URI=http://localhost:3000/redirect.html
# Optional when the hosted agent shares the Persistence API app registration.
VITE_HOSTED_AGENT_SCOPE=
VITE_PERSISTENCE_API_SCOPE=api://<API-APPLICATION-ID>/access_as_user
# App roles checked by the UI authorization service before rendering pages.
VITE_AGENT_INVOKE_APP_ROLE=Agent.Invoke
VITE_INTERACTION_HISTORY_READ_APP_ROLE=InteractionHistory.Read
VITE_PERSISTENCE_HISTORY_URL=/api/agent-interactions
VITE_PERSISTENCE_ANALYTICS_URL=/api/pcr-analytics
VITE_PERSISTENCE_DEMAND_DRIVER_ANALYTICS_URL=/api/demand-driver-analytics
VITE_PERSISTENCE_VULNERABILITY_ANALYTICS_URL=/api/vulnerability-analytics
