# Hosted agent
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_DEPLOYMENT_NAME=YOUR-MODEL-DEPLOYMENT
AGENT_NAME=pcr-agent
AGENT_VERSION=1.0.0
RESULT_SCHEMA_VERSION=generic-v1
AGENT_AUTH_MODE=default
MODEL_TIMEOUT_SECONDS=90
MAX_INPUT_CHARS=20000
MAX_RESULT_BYTES=65536
MAX_SYSTEM_PROMPT_BYTES=65536

# Prompt source: file for local development; blob in Azure.
SYSTEM_PROMPT_SOURCE=file
SYSTEM_PROMPT_PATH=prompts/system_prompt.example.txt
SYSTEM_PROMPT_VERSION=local-v1
PROMPT_STORAGE_ACCOUNT_URL=
PROMPT_CONTAINER=
PROMPT_BLOB_NAME=
# For blob, use an immutable Azure Blob version ID (requires Blob versioning).
PROMPT_VERSION=

# Optional batch input. Configure either the Azure Blob settings or BATCH_FILE_PATH.
# The value in BATCH_VALUE_COLUMN is sent to the model as that row's user prompt.
BATCH_STORAGE_ACCOUNT_URL=
BATCH_CONTAINER=
BATCH_BLOB_NAME=
BATCH_VALUE_COLUMN=
# Optional immutable blob version ID for the batch input.
BATCH_BLOB_VERSION_ID=
# Optional local CSV path. The CSV must contain the configured BATCH_VALUE_COLUMN.
BATCH_FILE_PATH=

# Persistence API client. Scope must match the API's Entra app registration.
PERSISTENCE_API_URL=http://localhost:7071/api/pcr-results
PERSISTENCE_API_SCOPE=api://YOUR-API-APPLICATION-ID/.default
PERSISTENCE_API_TIMEOUT_SECONDS=15
PERSISTENCE_API_RETRIES=1

# Persistence API authentication. Configure API_TENANT_ID, API_AUDIENCE and either
# API_REQUIRED_SCOPE or API_REQUIRED_APP_ROLE before starting the Function App.
API_TENANT_ID=YOUR-TENANT-ID
API_AUDIENCE=api://YOUR-API-APPLICATION-ID
API_REQUIRED_SCOPE=access_as_user
API_REQUIRED_APP_ROLE=
API_ALLOWED_CLIENT_IDS=
PERSISTENCE_AGENT_NAME=pcr-agent
PERSISTENCE_AGENT_VERSION=1.0.0
PERSISTENCE_SCHEMA_VERSION=generic-v1
MAX_REQUEST_BYTES=131072
RETENTION_DAYS=365

# PostgreSQL Flexible Server. Use Entra auth in Azure; password/key vault is a
# local/deployment fallback only.
PGHOST=YOUR-SERVER.postgres.database.azure.com
PGPORT=5432
PGDATABASE=agentdb
PGSCHEMA=agent_platform
PGUSER=YOUR-ENTRA-ROLE
PG_AUTH_MODE=entra
PGPASSWORD=
KEY_VAULT_URL=
KEY_VAULT_SECRET_NAME=
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=5
PG_POOL_TIMEOUT_SECONDS=20
PG_CONNECT_TIMEOUT_SECONDS=10

APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO
